# انسخ هذا الملف إلى functions/.env واملأ القيم (الملف لا يُرفع إلى git).

# معرّف التطبيق في Android (Google Play) – يجب أن يطابق applicationId
ANDROID_PACKAGE_NAME=sa.taqdir.app

# السر المشترك لإيصالات App Store (App Store Connect > App Information)
APPLE_SHARED_SECRET=

# Algolia (اختياري – للبحث). اتركها فارغة لتعطيل المزامنة.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=
ALGOLIA_PACKS_INDEX=taqdir_packs
ALGOLIA_FLASHCARDS_INDEX=taqdir_flashcards

# اجعلها true في بيئة التجربة فقط لتفعيل دالة devGrant (اشتراك مؤقت للاختبار)
ALLOW_DEV_GRANT=false
